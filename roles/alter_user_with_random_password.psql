-- Generate and display a random password without putting it in psql history.
-- Passwords are still sensitive: server/audit logging and terminal capture may
-- record them, including error CONTEXT and nested pg_stat_statements tracking.
-- Review logging policy before using this on production systems.
-- Requires Postgres 13+ (built-in gen_random_uuid).

\prompt "Username?" postgres_dba_username
\prompt "Superuser? (1 yes, 0 no, Enter unchanged)" postgres_dba_is_superuser
\prompt "Login? (1 yes, 0 no, Enter unchanged)" postgres_dba_login

begin;

\o /dev/null
select set_config('postgres_dba.username', :'postgres_dba_username', true);
select set_config('postgres_dba.is_superuser', coalesce(nullif(:'postgres_dba_is_superuser', '')::boolean::text, ''), true);
select set_config('postgres_dba.login', coalesce(nullif(:'postgres_dba_login', '')::boolean::text, ''), true);
\o

do $$
declare
  pwd text;
begin
  if current_setting('postgres_dba.username') = '' then
    raise exception 'Username is not specified.';
  end if;
  -- Nested utility statements retain live passwords in pg_stat_statements.
  if current_setting('pg_stat_statements.track', true) = 'all' then
    raise exception 'Refusing password generation with pg_stat_statements.track=all';
  end if;
  -- UUID v4 provides 122 random bits; no extension is required on PG13+.
  pwd := replace(pg_catalog.gen_random_uuid()::text, '-', '');
  execute format('alter role %I %s %s password %L',
    current_setting('postgres_dba.username'),
    case
      when current_setting('postgres_dba.is_superuser') = '' then ''
      when current_setting('postgres_dba.is_superuser')::boolean then 'superuser'
      -- Only a superuser may specify even an unchanged NOSUPERUSER option.
      when (select rolsuper from pg_catalog.pg_roles where rolname = current_user) then 'nosuperuser'
      else ''
    end,
    case
      when current_setting('postgres_dba.login') = '' then ''
      when current_setting('postgres_dba.login')::boolean then 'login'
      else 'nologin'
    end,
    pwd);
  raise info 'User % altered, password: %', current_setting('postgres_dba.username'), pwd;
end;
$$ language plpgsql;

commit;

\unset postgres_dba_username
\unset postgres_dba_is_superuser
\unset postgres_dba_login
